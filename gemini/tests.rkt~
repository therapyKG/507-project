#lang rosette

(require "syntax.rkt")
(require "validate.rkt")

(module+ main
  (printf "Test 1: Standard MNIST (Should pass easily)\n")
  (train
   (model (bits 32)
    (sequence
     (linear 784 128 relu)
     (linear 128 10 softmax)))
   on
   (dataset "MNIST" 60000 (bits 32) 784)
   with ((vram 1024) (batch 64)))

  (printf "\nTest 2: High Res OOM Simulation\n")
  ;; This simulates a massive model that won't fit even with batch size 1 (or very small).
  ;; It checks if the solver correctly reports OOM.
  (train
   (model 
    (bits 16)
    (sequence
     (conv 3 64 3 relu)
     (conv 64 64 3 relu)
     (maxpool 2)
     (flatten)
     (linear 16777216 10)))
   on
   (dataset "HD-Image" 5000 3 1024 1024 (bits 16))
   with ((vram 4096) (batch 128)))
   
   (printf "\nTest 3: Dataset Caching Check\n")
   ;; Checks memory reporting for dataset caching.
   (train
    (model (bits 32)
     (sequence (linear 10 10)))
    on
    (dataset "BigData" 1000000 (bits 32) 10) 
    with ((vram 20) (batch 32)))

   (printf "\nTest 4: Soft Constraint Auto-Adjustment\n")
   ;; This is the new test case.
   ;; We request a batch of 256, but provide only 100MB of VRAM.
   ;; Based on the model size (~20MB static) and activations (~0.46MB/sample),
   ;; 256 samples would require ~137MB total, causing a failure.
   ;; The solver should catch this, drop the batch size to around ~170, and report SUCCESS (ADJUSTED).
   (train
    (model (bits 32)
     (sequence
      (conv 3 64 5 relu)
      (maxpool 2)
      (flatten)
      (linear 9216 128 relu)
      (linear 128 10 softmax)))
    on
    (dataset "CIFAR-10" 50000 (bits 32) 3 32 32)
    with ((vram 100) (batch 256)))
)