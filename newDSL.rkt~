#lang rosette

(require racket/match)
(require racket/format)

;; ============================================================
;; 1. Core Definitions & Activations
;; ============================================================

;; Activation keywords (defined as symbols for use in DSL)
(define relu 'relu)
(define tanh 'tanh)
(define sigmoid 'sigmoid)
(define softmax 'softmax)
(define none 'none)

;; Data structures
(struct layer (type params activation) #:transparent)
(struct model-struct (layers) #:transparent)
(struct dataset-struct (spec count shape) #:transparent)

;; ============================================================
;; 2. Layer Constructors
;;    Syntax: (type param1 param2 [activation])
;; ============================================================

(define (linear in-dim out-dim [act none])
  (layer 'linear (list in-dim out-dim) act))

(define (conv in-ch out-ch kernel [act none] #:stride [stride 1] #:padding [padding 0])
  (layer 'conv (list in-ch out-ch kernel stride padding) act))

(define (maxpool kernel [stride #f])
  (layer 'maxpool (list kernel (or stride kernel)) none))

(define (flatten)
  (layer 'flatten '() none))

;; ============================================================
;; 3. DSL Structural Elements
;; ============================================================

;; Wraps a list of layers
(define (sequence . layers)
  layers)

;; Wraps the sequence into a model
(define (model seq)
  (model-struct seq))

;; Captures dataset metadata
;; Usage: (dataset "MNIST" 60000 28 28 1) or (dataset "Flat" 1000 784)
(define (dataset spec count . dims)
  (dataset-struct spec count dims))

;; ============================================================
;; 4. Analysis & Validation Logic
;; ============================================================

;; Helper: Calculate parameters for a single layer
(define (count-layer-params lyr)
  (match lyr
    [(layer 'linear (list in out) _)
     (+ (* in out) out)] ; weights + bias
    [(layer 'conv (list in out k s p) _)
     (+ (* in out k k) out)] ; weights + bias
    [_ 0]))

;; Helper: Compute output shape given an input shape
;; Returns #f if shapes are incompatible
(define (compute-next-shape lyr input-shape)
  (match* (lyr input-shape)
    ;; Linear: Expects flat input matching in-dim
    [((layer 'linear (list in out) _) (list curr-dim))
     (if (= in curr-dim)
         (list out)
         (error (format "Dimension Mismatch: Linear layer expects ~a inputs, got ~a" in curr-dim)))]
    
    ;; Conv: Expects (channels height width)
    [((layer 'conv (list in out k s p) _) (list c h w))
     (if (= in c)
         (let ([out-h (quotient (+ h (* 2 p) (- k)) s)]
               [out-w (quotient (+ w (* 2 p) (- k)) s)])
           (list out out-h out-w))
         (error (format "Channel Mismatch: Conv layer expects ~a channels, got ~a" in c)))]
    
    ;; Maxpool: Expects (channels height width)
    [((layer 'maxpool (list k s) _) (list c h w))
     (let ([out-h (quotient h s)]
           [out-w (quotient w s)])
       (list c out-h out-w))]
    
    ;; Flatten: Flattens any shape to (product)
    [((layer 'flatten _ _) shape)
     (list (apply * shape))]
     
    [(_ _) (error (format "Unknown layer or invalid input shape for ~a on ~a" lyr input-shape))]))

;; Main Analysis Function
(define (analyze-training mdl data)
  (define input-shape (dataset-struct-shape data))
  (define layers (model-struct-layers mdl))
  (define total-params 0)
  
  (printf "\n=== Training Analysis ===\n")
  (printf "Dataset: ~a (~a items)\n" (dataset-struct-spec data) (dataset-struct-count data))
  (printf "Input Shape: ~a\n" input-shape)
  
  ;; Validate flow and count params
  (define final-shape
    (for/fold ([current-shape input-shape])
              ([l layers]
               [i (in-naturals 1)])
      
      ;; 1. Update param count
      (set! total-params (+ total-params (count-layer-params l)))
      
      ;; 2. Compute next shape (throws error if mismatch)
      (define next-shape (compute-next-shape l current-shape))
      
      (printf "Layer ~a (~a): Input ~a -> Output ~a | Act: ~a\n" 
              i (layer-type l) current-shape next-shape (layer-activation l))
      next-shape))
  
  (printf "-------------------------\n")
  (printf "Status: VALID ARCHITECTURE\n")
  (printf "Total Parameters: ~a\n" total-params)
  (printf "Output Dimension: ~a\n" final-shape)
  (printf "=========================\n"))

;; ============================================================
;; 5. The Top-Level Macro
;; ============================================================

(define-syntax train
  (syntax-rules (on)
    [(_ model-expr on dataset-expr)
     (analyze-training model-expr dataset-expr)]))

;; ============================================================
;; 6. Examples
;; ============================================================

(module+ main
  ;; Example 1: Simple MLP on Flat Data
  (train
   (model
    (sequence
     (linear 784 128 relu)
     (linear 128 64 tanh)
     (linear 64 10 softmax)))
   on
   (dataset "MNIST-Flat" 60000 784))

  ;; Example 2: ConvNet on Image Data
  ;; Note: (dataset ... 1 28 28) = 1 channel, 28x28 images
  (train
   (model
    (sequence
     (conv 1 32 3 relu)        ; 1 -> 32 channels
     (maxpool 2)               ; downsample
     (flatten)                 ; flatten 3D volume to 1D
     (linear 5408 10 softmax)  ; 32 * 13 * 13 = 5408 inputs
     ))
   on
   (dataset "MNIST-Image" 60000 1 28 28)))